{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Reference to ChatSession"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant",
        "system"
      ],
      "description": "Message sender role"
    },
    "content": {
      "type": "string",
      "description": "Message text content"
    },
    "metadata": {
      "type": "object",
      "description": "Additional message metadata like outcomes, resources"
    }
  },
  "required": [
    "session_id",
    "role",
    "content"
  ]
}